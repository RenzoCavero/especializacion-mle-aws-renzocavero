# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
pytest-cache-files-*/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Local environment and AWS-generated config
.env
.env.*
!.env.example
!**/.env.example

# Logs and temporary files
*.log
*.tmp
*.temp
*cloudtrail*.json
*cloudtrail*.jsonl
cloudtrail-*.json
cloudtrail-*.jsonl
.DS_Store
Thumbs.db

# Lab-generated local data
**/data/local_cache/*
