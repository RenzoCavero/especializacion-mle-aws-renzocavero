# Modo del laboratorio.
# Valores posibles: standalone, integrated
LAB_MODE=standalone

# Configuracion AWS.
AWS_PROFILE=654654589924_PowerUserAccess #mlops-2-data-prep-lab   654654589924_PowerUserAccess
AWS_REGION=us-east-1

# Convenciones generales.
PROJECT_NAME=mlops-aws
ENVIRONMENT=lab
RESOURCE_PREFIX=mlops-lab
# Si queda vacio, make deploy-infra crea un bucket del laboratorio y escribe el valor en .env.cloud.
S3_BUCKET_NAME=
SAGEMAKER_EXECUTION_ROLE_ARN=
LAMBDA_EXECUTION_ROLE_ARN=
STEPFUNCTIONS_ROLE_ARN=
EVENTBRIDGE_TO_SFN_ROLE_ARN=
KMS_KEY_ARN=
# Vacio = automatico. true = crear bucket. false = usar S3_BUCKET_NAME existente.
CREATE_BUCKET=

# Recursos de Model Registry y despliegue.
MODEL_PACKAGE_GROUP_NAME=mlops-model-package-group
MODEL_PACKAGE_ARN=
MODEL_ARTIFACT_S3_URI=
MODEL_IMAGE_URI=
# Opcional. Vacio = se resuelve automaticamente para regiones conocidas, como us-east-1.
MODEL_MONITOR_IMAGE_URI=
ENDPOINT_NAME=mlops-lab-endpoint

# Recursos opcionales para integrated_mode.
FEATURE_GROUP_NAME=
FEATURE_CONTRACT_S3_URI=
DATA_CAPTURE_S3_URI=

# Flags de ejecucion.
CREATE_STANDALONE_DATASET=true
CREATE_STANDALONE_MODEL=true
CREATE_ENDPOINT=true
ENABLE_DATA_CAPTURE=true
# Native Model Quality Monitor needs endpoint input and output capture.
# Keep endpoint responses JSON-compatible when this is true.
CAPTURE_ENDPOINT_OUTPUT=true
ENABLE_MODEL_MONITOR=true
ENABLE_CLOUDWATCH_ALARM=true
ENABLE_EVENTBRIDGE=true
ENABLE_FEEDBACK_LOOP=true
ENABLE_AUTOMATIC_RETRAINING=false

# Instancias recomendadas para laboratorio.
INSTANCE_TYPE=ml.m5.large
TRAINING_INSTANCE_TYPE=ml.m5.large
PROCESSING_INSTANCE_TYPE=ml.m5.large
MODEL_MONITOR_PROCESSING_INSTANCE_TYPE=ml.m6i.large
# Seleccion automatica de compute basada en Service Quotas. Si una cuota es 0, se usa el siguiente candidato.
AUTO_SELECT_COMPUTE=true
INSTANCE_TYPE_CANDIDATES=ml.c6i.large,ml.m6i.large,ml.m5.large,ml.m5.xlarge
TRAINING_INSTANCE_TYPE_CANDIDATES=ml.m6i.large,ml.m5.xlarge,ml.m5.large,ml.c6i.xlarge,ml.c5.xlarge
PROCESSING_INSTANCE_TYPE_CANDIDATES=ml.t3.medium,ml.t3.large,ml.m6i.large,ml.m5.xlarge,ml.m5.large,ml.c6i.xlarge,ml.c5.xlarge
MODEL_MONITOR_PROCESSING_INSTANCE_TYPE_CANDIDATES=ml.m6i.large,ml.m5.xlarge,ml.c6i.xlarge,ml.c5.xlarge,ml.t3.large,ml.t3.medium
BATCH_TRANSFORM_INSTANCE_TYPE_CANDIDATES=ml.c6i.large,ml.m6i.large,ml.m5.xlarge,ml.m5.large,ml.c6i.xlarge,ml.c5.xlarge

# Ruta batch opcional. Vacio = usar defaults bajo el bucket del laboratorio.
BATCH_TRANSFORM_INPUT_S3_URI=
BATCH_TRANSFORM_OUTPUT_S3_URI=
BATCH_DATA_CAPTURE_S3_URI=
BATCH_MONITORING_S3_URI=
BATCH_MONITORING_SCHEDULE_NAME=mlops-lab-batch-monitoring-schedule

# Nombres de monitoreo y feedback loop.
MONITORING_SCHEDULE_NAME=mlops-monitoring-schedule
ALARM_NAME=mlops-data-quality-alarm
MODEL_QUALITY_SCHEDULE_NAME=mlops-model-quality-schedule
MODEL_QUALITY_JOB_DEFINITION_NAME=mlops-model-quality-job-def
MODEL_QUALITY_ALARM_NAME=mlops-model-quality-alarm
CUSTOM_DATA_QUALITY_ALARM_NAME=mlops-custom-data-quality-alarm
CUSTOM_BATCH_DATA_QUALITY_ALARM_NAME=mlops-custom-batch-data-quality-alarm
CUSTOM_MODEL_QUALITY_ALARM_NAME=mlops-custom-model-quality-alarm
CUSTOM_MODEL_QUALITY_SCHEDULE_NAME=mlops-custom-model-quality-schedule
CUSTOM_MODEL_QUALITY_TRIGGER_LAMBDA_NAME=mlops-custom-model-quality-trigger
CUSTOM_DATA_QUALITY_SCHEDULE_NAME=mlops-custom-data-quality-schedule
CUSTOM_DATA_QUALITY_TRIGGER_LAMBDA_NAME=mlops-custom-data-quality-trigger
CUSTOM_BATCH_DATA_QUALITY_SCHEDULE_NAME=mlops-custom-batch-data-quality-schedule
CUSTOM_BATCH_DATA_QUALITY_TRIGGER_LAMBDA_NAME=mlops-custom-batch-data-quality-trigger
STATE_MACHINE_NAME=mlops-feedback-loop

# Guardrails adicionales.
PIPELINE_NAME=mlops-build-pipeline
F1_THRESHOLD=0.70
AUC_THRESHOLD=0.70
# Model Monitor soporta hourly/daily/NOW y tasas horarias enteras. El minuto debe ser 0.
MONITORING_CRON_EXPRESSION=cron(0 * ? * * *)
METRIC_NAMESPACE=MLOps/Lab
VIOLATIONS_METRIC_NAME=DataQualityViolations
BATCH_VIOLATIONS_METRIC_NAME=BatchDataQualityViolations
MODEL_QUALITY_METRIC_NAMESPACE=aws/sagemaker/Endpoints/model-metrics
MODEL_QUALITY_NATIVE_METRIC_NAME=f1
MODEL_QUALITY_ACCURACY_METRIC_NAME=ModelQualityAccuracy
MODEL_QUALITY_F1_METRIC_NAME=ModelQualityF1
MODEL_QUALITY_AUC_METRIC_NAME=ModelQualityAUC
MODEL_QUALITY_RECORDS_METRIC_NAME=ModelQualityRecords
MODEL_QUALITY_ACCURACY_THRESHOLD=0.75
MODEL_QUALITY_F1_THRESHOLD=0.70
MODEL_QUALITY_AUC_THRESHOLD=0.70
MODEL_QUALITY_MIN_RECORDS=20
MODEL_QUALITY_PROBLEM_TYPE=BinaryClassification
MODEL_QUALITY_INFERENCE_ATTRIBUTE=prediction
MODEL_QUALITY_PROBABILITY_ATTRIBUTE=probability
MODEL_QUALITY_PROBABILITY_THRESHOLD=0.5
MODEL_QUALITY_START_TIME_OFFSET=-PT1H
MODEL_QUALITY_END_TIME_OFFSET=-PT0H
MODEL_QUALITY_MONITORING_CRON_EXPRESSION=cron(0 * ? * * *)
# Fallback custom Model Quality job. The cron creates EventBridge -> Lambda -> SageMaker Processing Job.
CUSTOM_MODEL_QUALITY_CRON_EXPRESSION=cron(0 * ? * * *)
CUSTOM_MODEL_QUALITY_WINDOW_HOURS=24
# Fallback custom Data Quality job. The cron creates EventBridge -> Lambda -> SageMaker Processing Job.
CUSTOM_DATA_QUALITY_CRON_EXPRESSION=cron(0 * ? * * *)
CUSTOM_DATA_QUALITY_WINDOW_HOURS=24

# Fallback custom Batch Data Quality job. The cron evaluates the configured batch input in S3.
CUSTOM_BATCH_DATA_QUALITY_CRON_EXPRESSION=cron(0 * ? * * *)
ALARM_SNS_TOPIC_NAME=mlops-lab-alarm-notifications
ALARM_EMAIL=enriquemejiagamarra@gmail.com
ALARM_THRESHOLD=1.0
ALARM_PERIOD_SECONDS=300
ALARM_EVALUATION_PERIODS=1
ALARM_DATAPOINTS_TO_ALARM=1
ALARM_TREAT_MISSING_DATA=notBreaching
ENABLE_ROLLBACK_EXECUTION=false
ENABLE_BASELINE_UPDATE=false
