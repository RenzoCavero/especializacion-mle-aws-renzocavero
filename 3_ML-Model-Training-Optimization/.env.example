# Copy this file to .env and fill in values for your AWS account.
# Do not store real credentials here.

AWS_PROFILE=mlops-2-data-prep-lab
AWS_REGION=us-east-1

PROJECT_NAME=ml-model-training-optimization
ENVIRONMENT=lab
RESOURCE_PREFIX=ml-training-opt-lab

# Optional. Leave empty to let CloudFormation generate a bucket name.
S3_BUCKET_NAME=

# Filled by scripts/deploy_infra.* into .env.cloud if left empty here.
SAGEMAKER_EXECUTION_ROLE_ARN=

FEATURE_GROUP_NAME=churn-customer-features
MODEL_PACKAGE_GROUP_NAME=churn-model-package-group
ENABLE_ONLINE_STORE=true
ENABLE_OFFLINE_STORE=true

# Dataset source for the Processing step that prepares train/validation/test.
# offline_store = materialize latest records from Feature Store Offline Store through Athena.
# snapshot = use the CSV snapshot uploaded to s3://<bucket>/processing/input/churn_features.csv.
FEATURE_DATA_SOURCE=offline_store
ALLOW_FEATURE_SNAPSHOT_FALLBACK=true
OFFLINE_STORE_MAX_WAIT_SECONDS=900
OFFLINE_STORE_POLL_SECONDS=60

# Keep the default low for student accounts. Override only when needed.
PROCESSING_INSTANCE_TYPE=ml.t3.medium
TRAINING_INSTANCE_TYPE=ml.t3.medium
PROCESSING_INSTANCE_TYPE_FALLBACKS=ml.t3.medium,ml.t3.large,ml.m5.large,ml.m5.xlarge
TRAINING_INSTANCE_TYPE_FALLBACKS=ml.t3.medium,ml.t3.large,ml.m5.large,ml.m5.xlarge
PROCESSING_INSTANCE_COUNT=1
TRAINING_INSTANCE_COUNT=1
HPO_MAX_JOBS=4
HPO_MAX_PARALLEL_JOBS=1
WAIT_FOR_JOBS=true

# When true, step 03 and the optional SageMaker Pipeline update Feature Store
# from s3://<bucket>/curated/churn_features.csv using a Processing Job.
PROCESSING_INGEST_FEATURE_STORE=true

# Optional Autopilot/AutoML demo. It is intentionally minimal because AutoML can
# create several jobs and generate additional cost. The goal is to see the UI,
# candidate leaderboard and generated artifacts, not to search for the best model.
AUTOPILOT_MAX_CANDIDATES=2
AUTOPILOT_MAX_RUNTIME_SECONDS=900
AUTOPILOT_MODE=ENSEMBLING
AUTOPILOT_ALGORITHMS=linear-learner,xgboost

# Optional encryption key. Leave empty to use SSE-S3.
KMS_KEY_ARN=

# Cleanup guardrails. destroy-infra always empties the stack-owned LabBucket before deleting
# CloudFormation; this flag is only for standalone src.cleanup_resources runs.
DELETE_FEATURE_GROUP_ON_CLEANUP=true
DELETE_S3_OBJECTS_ON_CLEANUP=false
STOP_ACTIVE_JOBS_ON_CLEANUP=false
DELETE_MODEL_REGISTRY_ON_CLEANUP=true
DELETE_PIPELINE_ON_CLEANUP=true
DELETE_EXPERIMENTS_ON_CLEANUP=true

# CloudFormation stack name.
STACK_NAME=ml-training-opt-lab
